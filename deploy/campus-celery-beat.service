[Unit]
Description=Campus Backend — Celery Beat Scheduler
After=network.target redis-server.service mysql.service
Requires=redis-server.service
# Without this, systemd's default rate limit (5 restarts within 10s) is
# quickly exhausted by Restart=always/RestartSec=5 below whenever MySQL
# isn't up yet at boot — the service then stays dead until someone notices
# and restarts it by hand (see the July 31 échéancier-reminder outage:
# beat crashed on "Can't connect to local MySQL server", burned through
# its restart budget in under 30s, and sat dead for 3 days). 0 = no limit,
# so it just keeps retrying every RestartSec until MySQL answers.
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/var/www/campus/campus-backend
Environment=PATH=/var/www/campus/campus-backend/venv/bin
Environment=PYTHONPATH=/var/www/campus/campus-backend
Environment=DJANGO_SETTINGS_MODULE=config.settings
EnvironmentFile=/var/www/campus/campus-backend/.env
ExecStart=/var/www/campus/campus-backend/venv/bin/celery \
    -A config beat \
    --loglevel=info \
    --logfile=/var/log/campus-celery-beat.log \
    --scheduler django_celery_beat.schedulers:DatabaseScheduler
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
