[Unit]
Description=Escam Backend — Celery Beat Scheduler
After=network.target redis.service mysql.service
Requires=redis.service
# Without this, systemd's default rate limit (5 restarts within 10s) is
# quickly exhausted by Restart=always/RestartSec=5 below whenever MySQL
# isn't up yet at boot — the service then stays dead until someone notices
# and restarts it by hand (see campus-celery-beat.service — same failure
# mode caused a 3-day échéancier-reminder outage there). 0 = no limit, so
# it just keeps retrying every RestartSec until MySQL answers.
StartLimitIntervalSec=0

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/escam/backend
Environment=PATH=/var/www/escam/backend/venv/bin
Environment=PYTHONPATH=/var/www/escam/backend
Environment=DJANGO_SETTINGS_MODULE=config.settings
EnvironmentFile=/var/www/escam/backend/.env
ExecStart=/var/www/escam/backend/venv/bin/celery \
    -A config beat \
    --loglevel=info \
    --logfile=/var/log/escam/celery-beat.log \
    --scheduler django_celery_beat.schedulers:DatabaseScheduler
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
