[Unit]
Description=Campus Backend — Celery Worker
After=network.target redis.service mysql.service
Requires=redis.service
# See campus-celery-beat.service for why this matters — same crash-then-
# permanently-dead failure mode if MySQL isn't up yet when this starts.
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/var/www/campus/campus-backend
Environment=PATH=/var/www/campus/campus-backend/venv/bin
Environment=PYTHONPATH=/var/www/campus/campus-backend
Environment=DJANGO_SETTINGS_MODULE=config.settings
EnvironmentFile=/var/www/campus/campus-backend/.env
ExecStart=/var/www/campus/campus-backend/venv/bin/celery \
    -A config worker \
    --loglevel=info \
    --logfile=/var/log/campus-celery.log \
    --concurrency=2
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
